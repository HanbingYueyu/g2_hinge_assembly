# Training runs are generated. Keep only the two compact runtime models used
# by the traditional detector.
/runs/**
!/runs/right_d405_new_target_seg_torch/
!/runs/right_d405_new_target_seg_torch/positive_only_v5/
!/runs/right_d405_new_target_seg_torch/positive_only_v5/best.pt
!/runs/right_d405_shaft_seg_torch/
!/runs/right_d405_shaft_seg_torch/mixed_auto_p4_v7/
