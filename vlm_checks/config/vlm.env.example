# Copy to vlm.env, set credentials, and keep that file out of Git.
# Local profile: LAN OpenAI-compatible VLM service.
VLM_LOCAL_API_KEY=replace-with-the-same-random-key-as-the-LAN-server
VLM_LOCAL_API_URL=http://192.168.30.13:8000/v1
VLM_LOCAL_MODEL=qwen3-vl-8b-local

# Online profile: DashScope OpenAI-compatible API.
VLM_ONLINE_API_KEY=replace-with-your-online-api-key
VLM_ONLINE_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_ONLINE_MODEL=qwen3.8-flash

# Legacy names remain supported for existing local config files:
# VLM_LAN_API_KEY=replace-with-the-same-random-key-as-the-LAN-server
# VLM_API_URL=http://192.168.30.13:8000/v1
# VLM_MODEL=qwen3-vl-8b-local
# DASHSCOPE_API_KEY=sk-your-online-api-key
