# LAN OpenAI-compatible VLM service. Copy this file to vlm.env and set the real value.
VLM_LAN_API_KEY=replace-with-the-same-random-key-as-the-LAN-server
VLM_API_URL=http://192.168.30.12:8000/v1
VLM_MODEL=qwen3-vl-8b-local

# Optional legacy DashScope fallback:
# DASHSCOPE_API_KEY=sk-your-beijing-dashscope-key
